# =============================================================================
# versions.env — Pinned component versions and runtime settings
#
# This file is the single source of truth for which hermes-agent and
# hermes-webui versions are built into the container image.
#
# build.sh, up.sh, and down.sh all read from this file.
# =============================================================================

# ---------------------------------------------------------------------------
# Component versions (pinned for reproducible builds)
# ---------------------------------------------------------------------------
AGENT_VERSION=v0.23.1
WEBUI_VERSION=v0.52.667
# Portcullis (PII gateway) — commit SHA; the project has no release tags yet.
# Bumped manually (auto-update.yml tracks agent/webui only).
PORTCULLIS_VERSION=e9d5f734b9d1a808b7b0869a8cb1a8b856675a54

# ---------------------------------------------------------------------------
# Runtime selector
# ---------------------------------------------------------------------------
# Controls which container runtime the helper scripts (build.sh, up.sh,
# down.sh) use.
#
#   auto         — detect podman first, fall back to docker (default)
#   podman       — use podman / podman-compose
#   docker       — use docker / docker compose
#   docker-nolog — same as docker but suppresses log output
#
CONTAINER_RUNTIME=auto

# ---------------------------------------------------------------------------
# Sudo mode
# ---------------------------------------------------------------------------
# Set to true to run docker/podman commands with sudo (rootful mode).
# Rootless Podman and Docker (user in docker group) should use false.
#
USE_SUDO=false

# ---------------------------------------------------------------------------
# WhatsApp bridge
# ---------------------------------------------------------------------------
# The WhatsApp bridge is NOT included in the image by default for security
# reasons. Set to true to include it at build time.
# See: https://github.com/NousResearch/hermes-agent/issues/15108
#
ENABLE_WHATSAPP_BRIDGE=false

# ---------------------------------------------------------------------------
# Dashboard credentials
# ---------------------------------------------------------------------------
# Since hermes-agent v2026.7.1, the dashboard requires authentication.
# Set the login credentials for the dashboard here.
#
#   admin:admin    — default, works immediately (change for internet exposure)
#   auto           — auto-generate a random password, printed by ./up.sh
#   user:password  — your own username:password pair
#
DASHBOARD_CREDENTIAL=admin:admin

# ---------------------------------------------------------------------------
# WebUI password
# ---------------------------------------------------------------------------
# Separate mechanism from DASHBOARD_CREDENTIAL above — hermes-webui (the
# chat UI on port 8787) enforces this itself. It has no default and no
# "auto" option; unset means the WebUI has no login at all. hermes-webui's
# own docs call this required if the port is reachable from anything other
# than 127.0.0.1.
#
#HERMES_WEBUI_PASSWORD=some-strong-password

# ---------------------------------------------------------------------------
# Browser tooling (optional, build-time)
# ---------------------------------------------------------------------------
# The default image keeps the base image's pinned Chromium for the browser
# toolset. Set to false to strip it (no local-Chromium OOM risk). Since
# v0.23.1 Chromium ships in the base image's layers, so this no longer
# reduces pull size (it saved ~1.1GB on arm64 before). Intended for
# low-resource edge devices (4GB-class boards/VMs), which can use a
# cloud browser backend instead of local Chromium.
# Equivalent CLI flag: ./build.sh --no-browser
#ENABLE_BROWSER=false

# ---------------------------------------------------------------------------
# Portcullis PII gateway (runtime)
# ---------------------------------------------------------------------------
# On by default: Hermes' model calls are routed through Portcullis on
# 127.0.0.1:8080 inside the container, which strips private values (emails,
# phone numbers, taught terms, ...) before the prompt reaches the provider.
# start.sh rewrites model.base_url in config.yaml and restores it when
# disabled. Set to false to turn it off.
#PORTCULLIS_ENABLED=false
