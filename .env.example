# =============================================================================
# .env.example — Hermes Suite Configuration
# Copy to .env and fill in your values. This file is for reference only;
# the actual config lives in ~/.hermes/.env and ~/.hermes/config.yaml
# which are mounted into the container.
# =============================================================================

# --- UID/GID for Podman user namespace mapping ---
# Set these to match your WSL user to avoid permission issues.
# Find with: id -u   and   id -g
HERMES_UID=1000
HERMES_GID=1000

# --- Persistent data paths (docker-compose.yaml) ---
# Leave unset for a plain `docker compose up` (e.g. Dokploy) — the compose
# file then falls back to named Docker volumes. ./up.sh sets these to
# $HOME/.hermes and $HOME/workspace automatically for local Podman/Docker use.
#HERMES_DATA=/home/youruser/.hermes
#HERMES_WORKSPACE=/home/youruser/workspace

# --- Dokploy (docker-compose.dokploy.yaml) ---
# Required: docker-compose.dokploy.yaml refuses to start without both —
# these are two separate, unrelated auth mechanisms:
#   DASHBOARD_CREDENTIAL   — hermes-agent's own auth, gates the Dashboard (9119)
#   HERMES_WEBUI_PASSWORD  — hermes-webui's own auth, gates the WebUI (8787)
#DASHBOARD_CREDENTIAL=admin:changeme
#HERMES_WEBUI_PASSWORD=some-strong-password
# Optional: override the published image tag / host ports.
#HERMES_SUITE_IMAGE_TAG=2026.7.20-0.52.113
#GATEWAY_PORT=8642
#WEBUI_PORT=8787
#DASHBOARD_PORT=9119
